# Example only. Never commit a filled .env or keys.
# Preview claims remain disabled unless the explicit live gate is set.
PORT=8788
WMC_FAUCET_ORIGIN=https://faucet.winmarchain.io
WMC_RPC=https://rpc.winmarchain.io
REDIS_URL=redis://127.0.0.1:6379
# Live mode: use authenticated rediss://, noeviction and durable AOF
# WMC_PROXY_SOCKET=/run/winmar-faucet/faucet.sock
WMC_ENABLE_LIVE_CLAIMS=disabled
# Production only after independent review and operator authorization:
# WMC_FAUCET_CONTRACT=<verified deployed contract address>
# WMC_RELAYER_PRIVATE_KEY=<dedicated non-validator relayer private key>
# TURNSTILE_SECRET=<secret from official production widget>
# WMC_EXPECTED_RELAYER_ADDRESS=<approved dedicated public relayer wallet>
